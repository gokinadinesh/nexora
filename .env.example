# ==============================================================================
# NEXORA — Environment Configuration Example
# "Enter the Grid. Outsmart the Network."
# ==============================================================================
# Copy this file to .env in your root or server directory and customize values.
# DO NOT commit real secrets or production credentials to source control.

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Node.js / Express backend server
PORT=4000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# URL of the frontend application for CORS headers and Socket.IO authorization
CLIENT_URL=http://localhost:5173

# Comma-separated allowed CORS origins (leave blank to default to CLIENT_URL + localhost)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora

# Set to 'true' to force in-memory SQLite/pg-mem fallback (useful for testing/CI)
USE_MEMORY_DB=false

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens.
# CRITICAL: In production, this MUST be a cryptographically strong random string
# (minimum 32 characters). The server will refuse to start in production if the
# default development secret is detected.
JWT_SECRET=development_secret_change_in_production_min_32_chars

# Secret key required for manual operator promotion (/api/monitoring/promote).
# In production, promotion is disabled unless this secret is explicitly configured
# with a non-default high-entropy value.
OPERATOR_SECRET=nexora-secret-operator-key-stage7

# Comma-separated list of usernames automatically granted OPERATOR privileges.
# In development, defaults to: operator,nexus_operator,admin.
# In production, NO usernames are granted OPERATOR privileges unless explicitly listed here.
OPERATOR_USERNAMES=operator,nexus_operator,admin

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & PROTECTION
# ------------------------------------------------------------------------------
# Sliding window in milliseconds for IP rate limiting on sensitive routes
RATE_LIMIT_WINDOW_MS=60000

# Maximum allowed requests per IP per window on sensitive routes (/api/auth/*, /api/matchmaking/*)
RATE_LIMIT_MAX_REQUESTS=60

# Maximum request body size limit (enforced at Express JSON parser)
BODY_LIMIT=100kb
