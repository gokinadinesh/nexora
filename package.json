{
  "name": "nexora-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA - Real-time multiplayer competitive cyber-strategy game",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "start": "node server/dist/server.js",
    "test:load": "node scripts/load-test.cjs",
    "db:migrate": "npm run db:migrate --workspace=server"
  },
  "keywords": [
    "multiplayer",
    "cyber-strategy",
    "realtime",
    "socketio",
    "react",
    "express"
  ],
  "author": "NEXORA Team",
  "license": "UNLICENSED"
}
